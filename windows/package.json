{
  "name": "pokebonk-windows",
  "version": "2.4.20",
  "description": "Pok\u00e9Bonk Production Desktop Client",
  "author": "JOWEND04",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.unofficial.pokebonk",
    "productName": "PokeBonk",
    "compression": "store",
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PokeBonk.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
