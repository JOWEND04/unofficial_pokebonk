{
  "name": "pokebonk-windows",
  "version": "2.1.0",
  "description": "PokéBonk Desktop Client with Auto-Updater & Fixed Scaling",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder --win portable"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR-GITHUB-USERNAME/YOUR-REPO-NAME.git"
  },
  "build": {
    "appId": "com.unofficial.pokebonk",
    "productName": "PokeBonk",
    "compression": "store",
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PokeBonk-Windows.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "YOUR-GITHUB-USERNAME",
      "repo": "YOUR-REPO-NAME"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.3.9"
  }
}
