{
  "name": "pokebonk-windows",
  "version": "1.4.1",
  "description": "PokéBonk Fullscreen Desktop Client with Discord RPC & Native Controls",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder --win portable"
  },
  "build": {
    "appId": "com.unofficial.pokebonk",
    "productName": "PokeBonk",
    "compression": "store",
    "npmRebuild": false,
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PokeBonk-Windows.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1"
  }
}
